FROM golang:1.23-alpine AS build
WORKDIR /build
COPY go.mod ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /app ./cmd/server
FROM alpine:3.21
RUN adduser -S -u 10001 aivoya
USER 10001
COPY --from=build /app /app
EXPOSE 8080
ENTRYPOINT ["/app"]
