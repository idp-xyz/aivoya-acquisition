# Generate independent high-entropy secrets; do NOT reuse these placeholders.
# python -c "import secrets;print(secrets.token_urlsafe(36))"
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
AIVOYA_ADMIN_TOKEN=REPLACE_WITH_DISTINCT_RANDOM_ADMIN_TOKEN
AIVOYA_WORKER_TOKEN=REPLACE_WITH_DISTINCT_RANDOM_WORKER_TOKEN
# Before using browser_render, build with INSTALL_BROWSER=true and enforce egress policies.
INSTALL_BROWSER=false
INSTALL_SCRAPLING=false
AIVOYA_FETCH_ENGINE=stdlib
# If using a browser in production, an externally enforced egress policy must be verified.
AIVOYA_ENV=development
AIVOYA_EGRESS_GUARD_VERIFIED=false
# Optional GitHub personal access token with minimal permissions; only used on api.github.com.
AIVOYA_GITHUB_TOKEN=

# Set this to include your actual, authorized operator contact before public collection.
AIVOYA_USER_AGENT=AIVOYA-Acquisition/1.0
